# ---------------------------------------------------------------------------
# Supabase keep-alive configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# One connection string per Supabase project, separated by commas.
# Get it from: Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Prefer the connection *pooler* host; the direct db.<ref>.supabase.co host is IPv6-only on
# many networks.
#
# The password is part of the URL, so percent-encode any of  , @ : / ? #  it contains:
#   @ -> %40      : -> %3A      / -> %2F      ? -> %3F      # -> %23      , -> %2C
SUPABASE_URLS=postgresql://postgres.abcdefghijkl:MyP%40ssword@aws-0-us-east-1.pooler.supabase.com:5432/postgres,postgresql://postgres.mnopqrstuvwx:0ther%2Dpass@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Either ONE table used for every project, or exactly one per URL in the same order.
# Names are matched case-sensitively, so write them exactly as the table was created.
SUPABASE_TABLES=public.keepalive_ping

# When to run. Spring 6-field cron (second minute hour day month weekday).
# Supabase pauses free projects after ~7 days of inactivity, so daily is ample.
# Set to "-" to disable the schedule and only run on startup / on demand.
KEEPALIVE_CRON=0 0 3 * * *
KEEPALIVE_TIMEZONE=UTC

# Ping every project once as soon as the service starts.
KEEPALIVE_RUN_ON_STARTUP=true

# Retries per project before a run is recorded as failed (linear backoff).
KEEPALIVE_RETRY_ATTEMPTS=3
KEEPALIVE_RETRY_BACKOFF_MS=2000

KEEPALIVE_CONNECT_TIMEOUT_SECONDS=10
KEEPALIVE_QUERY_TIMEOUT_SECONDS=10

# Optional. When set, /api/** requires "Authorization: Bearer <token>".
KEEPALIVE_API_TOKEN=

# Optional alternative bearer token for an external cron scheduler.
CRON_SECRET=

# Allow a new request to take over an in-flight run stranded for this long.
KEEPALIVE_STALE_RUN_AFTER_SECONDS=300

# PORT, when injected by a hosting platform, takes precedence over this local value.
SERVER_PORT=8088

# Set to DEBUG to log each connection attempt (JDBC URL, user) and the SQL being run.
KEEPALIVE_LOG_LEVEL=INFO
