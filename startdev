#!/usr/bin/env bash
#
# Starts supabase-keepalive for local development.
#
#   ./startdev                                  # run with .env from the project root
#   ./startdev --keepalive.cron=-               # any extra args go to the application
#   ./startdev --keepalive.run-on-startup=false
#
# Stop with Ctrl-C.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

die() {
    printf '\033[31merror:\033[0m %s\n' "$1" >&2
    exit 1
}

info() {
    printf '\033[36m==>\033[0m %s\n' "$1"
}

# --- JDK ------------------------------------------------------------------
# This machine's default `java` is a JRE with no compiler, so a build needs a
# real JDK. Prefer an explicit JAVA_HOME, else pick the newest JDK 21+ found.
find_jdk() {
    if [[ -n "${JAVA_HOME:-}" && -x "${JAVA_HOME}/bin/javac" ]]; then
        echo "${JAVA_HOME}"
        return 0
    fi

    local best="" best_version=0 javac home version
    for javac in /usr/lib/jvm/*/bin/javac /opt/java/*/bin/javac "${HOME}"/.sdkman/candidates/java/*/bin/javac; do
        [[ -x "${javac}" ]] || continue
        home="${javac%/bin/javac}"
        version="$("${javac}" -version 2>&1 | awk '{print $2}' | cut -d. -f1)"
        [[ "${version}" =~ ^[0-9]+$ ]] || continue
        if (( version >= 21 && version > best_version )); then
            best="${home}"
            best_version="${version}"
        fi
    done

    [[ -n "${best}" ]] || return 1
    echo "${best}"
}

JAVA_HOME="$(find_jdk)" || die "no JDK 21+ found. Install one (sudo dnf install temurin-21-jdk) or set JAVA_HOME."
export JAVA_HOME
info "JDK: ${JAVA_HOME} ($("${JAVA_HOME}/bin/javac" -version 2>&1))"

# --- configuration --------------------------------------------------------
if [[ ! -f .env ]]; then
    [[ -f .env.example ]] || die ".env and .env.example are both missing."
    cp .env.example .env
    info "created .env from .env.example"
    die "fill in SUPABASE_URLS and SUPABASE_TABLES in .env, then run ./startdev again."
fi

if grep -qE '^SUPABASE_URLS=.*(abcdefghijkl|mnopqrstuvwx)' .env; then
    die ".env still contains the example connection strings. Replace them with your own."
fi

info "config: $(pwd)/.env ($(grep -cE '^SUPABASE_URLS=' .env) URLS line, $(awk -F= '/^SUPABASE_URLS=/{n=gsub(/,/,","); print n+1}' .env) project(s))"

# --- run ------------------------------------------------------------------
# spring-boot:run forks a JVM that runs main(), which is what loads .env.
info "starting (Ctrl-C to stop)"
exec ./mvnw -q -ntp spring-boot:run \
    ${1+-Dspring-boot.run.arguments="$*"}
