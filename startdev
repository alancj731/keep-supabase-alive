#!/usr/bin/env bash
#
# Starts supabase-keepalive for local development.
#
#   ./startdev                                  # run with .env from the project root
#   ./startdev --help                           # any extra args go to the application
#
# Stop with Ctrl-C.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

die() {
    printf '\033[31merror:\033[0m %s\n' "$1" >&2
    exit 1
}

info() {
    printf '\033[36m==>\033[0m %s\n' "$1"
}

# --- toolchain ------------------------------------------------------------
command -v go >/dev/null 2>&1 || die "go is not installed. Install it (sudo dnf install golang) or add it to PATH."
info "Go: $(go version)"

# --- configuration --------------------------------------------------------
if [[ ! -f .env ]]; then
    [[ -f .env.example ]] || die ".env and .env.example are both missing."
    cp .env.example .env
    info "created .env from .env.example"
    die "fill in SUPABASE_URLS and SUPABASE_TABLES in .env, then run ./startdev again."
fi

if grep -qE '^SUPABASE_URLS=.*(abcdefghijkl|mnopqrstuvwx)' .env; then
    die ".env still contains the example connection strings. Replace them with your own."
fi

projects="$(awk -F= '/^SUPABASE_URLS=/{n=gsub(/,/,","); print n+1; exit}' .env)"
info "config: $(pwd)/.env (${projects:-0} project(s))"

# --- run ------------------------------------------------------------------
info "starting (Ctrl-C to stop)"
exec go run . "$@"
